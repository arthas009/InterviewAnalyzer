# Interview Analyzer - Backend Configuration Template
# Copy this file to .env and fill in your actual values

# ========================================
# LLM Provider API Keys
# ========================================

# OpenAI (GPT-4 Turbo)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo

# Anthropic (Claude)
CLAUDE_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-3-opus-20240229

# Google Gemini
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-2.0-flash

# Groq (Fast LLM)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# ========================================
# Ollama Configuration (Local LLM)
# ========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ========================================
# Backend Configuration
# ========================================
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1

# ========================================
# Python Configuration
# ========================================
# Critical for Windows UTF-8 support and Turkish/non-ASCII characters
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# ========================================
# Audio Configuration
# ========================================
AUDIO_DEVICE_INDEX=-1  # -1 for default, specify index for specific device
SAMPLE_RATE=16000
VAD_SENSITIVITY=0.4

# ========================================
# Interview Configuration
# ========================================
# Options: technical, behavioral, system_design, coding, general
INTERVIEW_TYPE=technical

# Options: concise, detailed, code_focused
ANSWER_MODE=detailed

# ========================================
# STT (Speech-to-Text) Configuration
# ========================================
# Model size: tiny, base, small, medium, large
STT_MODEL_SIZE=small
# Language: auto for auto-detection, or specific code: en, es, fr, de, tr, etc.
STT_LANGUAGE=auto
# Device: cpu, cuda, mps
STT_DEVICE=cpu
# Compute type: default, auto, int8
STT_COMPUTE_TYPE=auto

# ========================================
# LLM Configuration
# ========================================
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
